@startuml

class Usuario {
  - idUsuario : int
  - nombre : String
  - apellido1 : String
  - apellido2 : String
  - correo_turbine : String
  - contrasena : String
  + iniciarSesion() : boolean
  + gestionarClientesAsignados() : void
}

class Administrador {
  + gestionarCarteraExtendida() : void
}

class SuperAdministrador {
  + asignarTareasYRoles() : void
  + gestionarSistemaCompleto() : void
}

Usuario <|-- Administrador
Administrador <|-- SuperAdministrador


class Cliente {
  - idCliente : int
  - nombreComercial : String
  - razonSocial : String
  - idFiscal : String
  - domicilioFiscal : String
  - pais : String
  - moneda : String
  - sector : String
  - estado : String
  + darDeBaja() : void
  + actualizarDatos() : void
}

class Contacto {
  - idContacto : int
  - nombre : String
  - email : String
  - telefono : String
  - activo : boolean
}

class AcuerdoComercial {
  - idAcuerdo : int
  - fechaInicio : Date
  - plan : String
  - tarifa : double
  - descuento : double
  - plazoPagoDias : int
  - condicionesPago : String
  - estado : String
  + renovar() : void
}

class Suscripcion {
  - idSuscripcion : int
  - fechaInicio : Date
  - fechaFin : Date
  - estado : String
  - excluirProrrateo : boolean
  - importeProrrateo : double
  - motivoPausa : String
  - fechaInicioPausa : Date
  - fechaFinPausa : Date
  + calcularProrrateo() : double
  + pausar() : void
  + reanudar() : void
  + cancelar() : void
}

class Factura {
  - idFactura : int
  - serie : String
  - numero : int
  - automatica : boolean
  - fechaEmision : Date
  - vencimiento : Date
  - estado : String
  - base : double
  - impuestos : double
  - total : double
  - moneda : String
  + calcularTotal() : double
  + aplicarDescuento() : void
  + generarPdf() : void
}

class Pago {
  - idPago : int
  - fecha : Date
  - importe : double
  - metodo : String
  - referenciaExterna : String
  - fuente : String
  - estadoConciliacion : String
  + procesarPago() : boolean
  + conciliar() : void
}

class Comunicacion {
  - idComunicacion : int
  - tipo : String
  - canal : String
  - destinatario : String
  - estado : String
  - fechaEnvio : DateTime
  + enviar() : void
}

class Incidencia {
  - idIncidencia : int
  - descripcion : String
  - estado : String
  - fechaCreacion : Date
  + resolver() : void
}

class ConfiguracionGlobal {
  - plazoPagoDefectoDias : int
  - diasRecordatorioPrevio : int
  - frecuenciaImpagoDias : int
  - umbralAprobacionDescuento : double
  - dominioCorreoPermitido : String
  + modificar(clave : String, valor : String, usuario : Usuario) : void
}

class Auditoria {
  - idAuditoria : int
  - fechaHora : DateTime
  - accion : String
  - tipoEntidad : String
  - idEntidad : String
  - valorAnterior : String
  - valorNuevo : String
}

Usuario "1" --> "*" Cliente : gestiona >
Cliente "1" -- "0..*" Factura : recibe >
Cliente "1" -- "1..*" Contacto : tiene >

Factura "1" --> "*" Pago : asocia >

Comunicacion "*" --> "1" Cliente : dirigida a >
Comunicacion "*" --> "1" Factura : asociada a >

Cliente "1" --> "*" Incidencia : reporta >
Cliente "1" --> "*" AcuerdoComercial : firma >
Cliente "1" --> "*" Suscripcion : tiene >
AcuerdoComercial "1" --> "*" Suscripcion : origina >
Suscripcion "1" --> "*" Factura : genera >

Auditoria "*" --> "0..1" Usuario : realizado por >

SuperAdministrador "*" --> "1" ConfiguracionGlobal : modifica >
ConfiguracionGlobal "1" --> "*" Auditoria : registra >
Factura ..> ConfiguracionGlobal : usa >

@enduml
