Codigo plantUML

@startuml
title CU10 - Procesar la baja del cliente

actor "Administrador / Usuario Operativo" as Usuario
boundary "Interfaz web" as Web
control "Gestión de clientes" as Clientes
control "Gestión de suscripciones y bajas" as Bajas
participant "Acceso a datos" as Datos
database "Base de datos" as BD

alt Baja inmediata
    Usuario -> Web : solicita la baja del cliente
    Web -> Clientes : procesarBaja(idCliente)
    Clientes -> Bajas : darDeBajaSuscripcion(idCliente)

    Bajas -> Datos : detener Facturacion Recurrente
    Datos -> BD : actualizar suscripción
    BD --> Datos : suscripción actualizada
    Datos --> Bajas : facturación recurrente detenida

    Bajas -> Datos : consultarFacturasPendientes(idCliente)
    Datos -> BD : buscar facturas pendientes de cobro
    BD --> Datos : facturas pendientes
    Datos --> Bajas : facturas pendientes

    Bajas -> Bajas : mantenerSeguimientoCobro()

    Bajas -> Datos : darDeBaja()
    Datos -> BD : actualizar estado de la suscripción
    BD --> Datos : suscripción en estado de baja
    Datos --> Bajas : suscripción dada de baja
    Bajas --> Clientes : suscripción dada de baja

    Clientes -> Datos : actualizarCliente(inactivo)
    Datos -> BD : actualizar estado del cliente
    BD --> Datos : cliente actualizado
    Datos --> Clientes : cliente dado de baja

    Clientes --> Web : cliente dado de baja
    Web --> Usuario : cliente inactivo con su historial

else Baja programada a futuro
    Usuario -> Web : programa la baja para fin de mes
    Web -> Clientes : programarBaja(idCliente, fecha)
    Clientes -> Bajas : programarBaja(idCliente, fecha)
    Bajas -> Datos : guardarBaja(idCliente, fecha)
    Datos -> BD : registrar baja programada
    BD --> Datos : baja programada
    Datos --> Bajas : baja programada
    Bajas --> Clientes : baja programada
    Clientes --> Web : baja programada
    Web --> Usuario : baja programada. Hasta la fecha está operativo el cliente.

    Bajas -> Bajas : ejecutarBajaProgramada(idSuscripcion)
    Bajas -> Clientes : notificarBajaEjecutada(idCliente)
end

opt Intento de borrado definitivo
    Usuario -> Web : eliminar cliente
    Web -> Clientes : eliminarCliente(idCliente)
    Clientes -> Clientes : comprobar Normativa 
    Clientes -> Datos : actualizarCliente(inactivo)
    Datos -> BD : actualizar estado del cliente
    BD --> Datos : cliente actualizado
    Datos --> Clientes : cliente actualizado, inactivo
    Clientes --> Web : acción denegada, forzado el borrado lógico
    Web --> Usuario : cliente inactivo
end

@enduml
